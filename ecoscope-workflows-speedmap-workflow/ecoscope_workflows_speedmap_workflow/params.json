    "traj_map_layers": {
      "additionalProperties": false,
      "properties": {
        "tooltip_columns": {
          "default": null,
          "items": {
            "type": "string"
          },
          "title": "Tooltip Columns",
          "type": "array",
          "description": "Restrict the on-hover tooltip to these column names. None (default) shows all properties.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": ""
    },
    "trend_bucket": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "",
          "type": "string"
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": ""
    },
    "trend_model": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinearTrendModel"
            },
            {
              "$ref": "#/$defs/GlmTrendModel"
            },
            {
              "$ref": "#/$defs/GamTrendModel"
            },
            {
              "$ref": "#/$defs/GammTrendModel"
            }
          ],
          "default": {
            "model": "gam",
            "family_settings": {
              "family": "gaussian"
            },
            "smoothing_settings": {
              "alpha": null,
              "metric": "aic"
            },
            "spline_settings": {
              "degree": 3,
              "degree_of_freedom": 6
            }
          },
          "title": "Model"
        }
      },
      "type": "object",
      "required": [],
      "title": ""

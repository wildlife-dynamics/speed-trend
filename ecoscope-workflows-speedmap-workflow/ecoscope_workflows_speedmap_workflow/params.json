          "title": "",
          "type": "string"
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": ""
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "SpatialGrouper": {
      "properties": {
        "spatial_index_name": {
          "title": "Spatial Regions",
          "type": "string"
        }
      },
      "required": [
        "spatial_index_name"
      ],
      "title": "Spatial",
      "type": "object"
    },
    "TemporalGrouper": {
      "properties": {
        "temporal_index": {
          "oneOf": [
            {
              "const": "%Y",
              "title": "Year (example: 2024)"
            },
            {
              "const": "%B",
              "title": "Month (example: September)"
            },
            {
              "const": "%Y-%m",
              "title": "Year and Month (example: 2023-01)"
            },
            {
              "const": "%j",
              "title": "Day of the year as a number (example: 365)"
            },
            {
              "const": "%d",
              "title": "Day of the month as a number (example: 31)"
            },
            {
              "const": "%A",
              "title": "Day of the week (example: Sunday)"
            },
            {
              "const": "%H",
              "title": "Hour (24-hour clock) as number (example: 22)"
            },
            {
              "const": "%Y-%m-%d",
              "title": "Date (example: 2025-01-31)"
            }
          ],
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "temporal_index"
      ],
      "title": "Time",
      "type": "object"
    },
    "ValueGrouper": {
      "properties": {
        "index_name": {
          "title": "Category",
          "type": "string"
        }
      },
      "required": [
        "index_name"
      ],
      "title": "Category",
      "type": "object"
    },
    "TrajectorySegmentFilter": {
      "properties": {
        "min_length_meters": {
          "default": 0.001,
          "ecoscope:advanced": true,
          "minimum": 0.001,
          "title": "Minimum Segment Length (Meters)",
          "type": "number"
        },
        "max_length_meters": {
          "default": 100000,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Length (Meters)",
          "type": "number"
        },
        "min_time_secs": {
          "default": 1,
          "ecoscope:advanced": true,
          "minimum": 1,
          "title": "Minimum Segment Duration (Seconds)",
          "type": "number"
        },
        "max_time_secs": {
          "default": 172800,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 1,
          "title": "Maximum Segment Duration (Seconds)",
          "type": "number"
        },
        "min_speed_kmhr": {
          "default": 0.01,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Minimum Segment Speed (Kilometers per Hour)",
          "type": "number"
        },
        "max_speed_kmhr": {
          "default": 500,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Speed (Kilometers per Hour)",
          "type": "number"
        }
      },
      "title": "TrajectorySegmentFilter",
      "type": "object"
    },
    "AddInterceptSettings": {
      "properties": {
        "add_intercept": {
          "default": true,
          "description": "Whether to fit a y-intercept term. Disable to force the line through the origin.",
          "ecoscope:advanced": true,
          "title": "Add Intercept",
          "type": "boolean"
        }
      },
      "title": "AddInterceptSettings",
      "type": "object"
    },
    "GamFamilySettings": {
      "properties": {
        "family": {
          "default": "gaussian",
          "description": "Distribution assumed for the response variable.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "gaussian",
              "title": "Gaussian"
            },
            {
              "const": "poisson",
              "title": "Poisson"
            },
            {
              "const": "binomial",
              "title": "Binomial"
            }
          ],
          "title": "Distribution Family",
          "type": "string"
        }
      },
      "title": "GamFamilySettings",
      "type": "object"
    },
    "GamSmoothingSettings": {
      "properties": {
        "alpha": {
          "default": null,
          "description": "Fixed smoothing strength. Leave empty to select automatically via cross-validation.",
          "ecoscope:advanced": true,
          "title": "Smoothing Parameter (Alpha)",
          "type": [
            "number",
            "null"
          ]
        },
        "metric": {
          "default": "aic",
          "description": "Used only when Alpha is left empty.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "aic",
              "title": "AIC"
            },
            {
              "const": "bic",
              "title": "BIC"
            },
            {
              "const": "euclidean",
              "title": "Euclidean Distance"
            },
            {
              "const": "mse",
              "title": "MSE"
            },
            {
              "const": "r_squared",
              "title": "R-Squared"
            }
          ],
          "title": "Alpha Selection Metric",
          "type": "string"
        }
      },
      "title": "GamSmoothingSettings",
      "type": "object"
    },
    "GamSplineSettings": {
      "properties": {
        "degree_of_freedom": {
          "default": 6,
          "description": "Number of basis functions for the spline. Higher values allow more flexible curves but risk overfitting.",
          "ecoscope:advanced": true,
          "title": "Spline Degrees of Freedom",
          "type": "integer"
        },
        "degree": {
          "default": 3,
          "description": "Polynomial degree of each spline segment (3 = cubic).",
          "ecoscope:advanced": true,
          "title": "Spline Degree",
          "type": "integer"
        }
      },
      "title": "GamSplineSettings",
      "type": "object"
    },
    "GamTrendModel": {
      "description": "Generalized additive model via B-splines. Smooths the trend rather\nthan fitting a straight line; the recommended default for most trend\ncharts.",
      "properties": {
        "model": {
          "const": "gam",
          "default": "gam",
          "enum": [
            "gam"
          ],
          "title": "Model",
          "type": "string"
        },
        "family_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GamFamilySettings"
            }
          ],
          "default": {
            "family": "gaussian"
          },
          "ecoscope:advanced": true,
          "title": "Distribution Family"
        },
        "smoothing_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GamSmoothingSettings"
            }
          ],
          "default": {
            "alpha": null,
            "metric": "aic"
          },
          "ecoscope:advanced": true,
          "title": "Smoothing"
        },
        "spline_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GamSplineSettings"
            }
          ],
          "default": {
            "degree_of_freedom": 6,
            "degree": 3
          },
          "ecoscope:advanced": true,
          "title": "Spline Shape"
        }
      },
      "title": "Generalized Additive Model (GAM)",
      "type": "object"
    },
    "GammFamilySettings": {
      "properties": {
        "family": {
          "default": "gaussian",
          "description": "Distribution assumed for the response variable.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "gaussian",
              "title": "Gaussian"
            },
            {
              "const": "poisson",
              "title": "Poisson"
            },
            {
              "const": "gamma",
              "title": "Gamma"
            },
            {
              "const": "bernoulli",
              "title": "Bernoulli"
            }
          ],
          "title": "Distribution Family",
          "type": "string"
        }
      },
      "title": "GammFamilySettings",
      "type": "object"
    },
    "GammMcmcSettings": {
      "properties": {
        "inference_method": {
          "default": "mcmc",
          "description": "MCMC is the reliable default for models with random effects; Laplace is faster when it converges but may fail for some model specifications.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "mcmc",
              "title": "MCMC"
            },
            {
              "const": "laplace",
              "title": "Laplace"
            }
          ],
          "title": "Inference Method",
          "type": "string"
        },
        "draws": {
          "default": 500,
          "description": "Number of posterior samples to draw per chain.",
          "ecoscope:advanced": true,
          "title": "Posterior Draws",
          "type": "integer"
        },
        "tune": {
          "default": null,
          "description": "Number of MCMC tuning steps. Leave empty to default to the same value as Posterior Draws.",
          "ecoscope:advanced": true,
          "title": "MCMC Tuning Steps",
          "type": [
            "integer",
            "null"
          ]
        },
        "chains": {
          "default": 2,
          "description": "Number of independent MCMC chains to run.",
          "ecoscope:advanced": true,
          "title": "MCMC Chains",
          "type": "integer"
        },
        "random_seed": {
          "default": null,
          "description": "Seed for the MCMC sampler. Leave empty for a non-deterministic fit.",
          "ecoscope:advanced": true,
          "title": "Random Seed",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "title": "GammMcmcSettings",
      "type": "object"
    },
    "GammSplineSettings": {
      "properties": {
        "degree_of_freedom": {
          "default": 10,
          "description": "Number of basis functions for the spline. Higher values allow more flexible curves but risk overfitting.",
          "ecoscope:advanced": true,
          "title": "Spline Degrees of Freedom",
          "type": "integer"
        }
      },
      "title": "GammSplineSettings",
      "type": "object"
    },
    "GammTrendModel": {
      "description": "Bayesian generalized additive mixed model with per-site random\neffects. A workflow fits this once across every site's combined data\n(site_ids derived automatically from a \"name\" column if present - see\nfit_trend_model), then predicts each site's own group-specific curve\nfrom that shared fit (see predict_trend_model's `dataframe` parameter) -\nunlike the other three models, which each fit and predict independently\nper site. Mainly useful here for its Bayesian credible intervals rather\nthan frequentist confidence intervals, at the added cost of MCMC\nsampling - both fitting and (since a fitted estimator can't cross a task\nboundary) every downstream prediction refit this model from scratch,\nmaking it substantially slower than the other three.",
      "properties": {
        "model": {
          "const": "gamm",
          "default": "gamm",
          "enum": [
            "gamm"
          ],
          "title": "Model",
          "type": "string"
        },
        "family_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GammFamilySettings"
            }
          ],
          "default": {
            "family": "gaussian"
          },
          "ecoscope:advanced": true,
          "title": "Distribution Family"
        },
        "spline_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GammSplineSettings"
            }
          ],
          "default": {
            "degree_of_freedom": 10
          },
          "ecoscope:advanced": true,
          "title": "Spline Shape"
        },
        "mcmc_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GammMcmcSettings"
            }
          ],
          "default": {
            "inference_method": "mcmc",
            "draws": 500,
            "tune": null,
            "chains": 2,
            "random_seed": null
          },
          "ecoscope:advanced": true,
          "title": "MCMC Sampling"
        }
      },
      "title": "Generalized Additive Mixed Model (GAMM)",
      "type": "object"
    },
    "GlmFamilySettings": {
      "properties": {
        "family": {
          "default": "gaussian",
          "description": "Distribution assumed for the response variable.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "gaussian",
              "title": "Gaussian"
            },
            {
              "const": "poisson",
              "title": "Poisson"
            },
            {
              "const": "binomial",
              "title": "Binomial"
            },
            {
              "const": "gamma",
              "title": "Gamma"
            }
          ],
          "title": "Distribution Family",
          "type": "string"
        }
      },
      "title": "GlmFamilySettings",
      "type": "object"
    },
    "GlmTrendModel": {
      "description": "Generalized linear model. Baseline for comparison against the smoothed\nmodels below - not recommended as the final trend line.",
      "properties": {
        "model": {
          "const": "glm",
          "default": "glm",
          "enum": [
            "glm"
          ],
          "title": "Model",
          "type": "string"
        },
        "family_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GlmFamilySettings"
            }
          ],
          "default": {
            "family": "gaussian"
          },
          "ecoscope:advanced": true,
          "title": "Distribution Family"
        },
        "intercept_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/AddInterceptSettings"
            }
          ],
          "default": {
            "add_intercept": true
          },
          "ecoscope:advanced": true,
          "title": "Add Intercept"
        }
      },
      "title": "Generalized Linear Model (GLM)",
      "type": "object"
    },
    "LinearTrendModel": {
      "description": "Ordinary least squares. No smoothing - a single straight-line trend.",

    "gamm_model": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alpha",
          "description": "Smoothing parameter. If None, will be optimized.",
          "ecoscope:advanced": true
        },
        "optimize_alpha": {
          "default": true,
          "title": "Optimize Alpha",
          "type": "boolean",
          "description": "Whether to optimize alpha parameter",
          "ecoscope:advanced": true
        },
        "metric": {
          "default": "AIC",
          "enum": [
            "AIC",
            "BIC",
            "Euclidean",
            "MSE",
            "R-Squared"
          ],
          "title": "Metric",
          "type": "string",
          "description": "Metric for optimization",
          "ecoscope:advanced": true
        },
        "degree_of_freedom": {
          "default": 10,
          "title": "Degree Of Freedom",
          "type": "integer",
          "description": "Degrees of freedom for spline basis",
          "ecoscope:advanced": true
        },
        "degree": {
          "default": 3,
          "title": "Degree",
          "type": "integer",
          "description": "Degree of B-spline basis",
          "ecoscope:advanced": true
        },
        "family": {
          "default": "Gaussian",
          "enum": [
            "Gaussian",
            "Poisson",
            "Binomial"
          ],
          "title": "Family",
          "type": "string",
          "description": "Distribution family for GLM",
          "ecoscope:advanced": true
        }

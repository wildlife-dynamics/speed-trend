          ],
          "title": "Model",
          "type": "string"
        },
        "intercept_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/AddInterceptSettings"
            }
          ],
          "default": {
            "add_intercept": true
          },
          "ecoscope:advanced": true,
          "title": "Add Intercept"
        }
      },
      "title": "Linear Regression",
      "type": "object"
    }
